pipeline {
    agent { label 'docker' }

    environment {
        PYTHON_VERSIONS = "3.8,3.9"
        DOCKERHUB_CREDENTIALS = "AsusHub"
        REPO_NAME = "omerasus3"
        APP_PATH = 'welcome/jenkins/labs/e2e/app'
    }

    stages {
        stage('Clone') {
            steps {
                git branch: 'jenkins-workshop', url: 'https://github.com/AsuSociety/devopshift-welcome.git'
            }
        }

        stage('Build, Test, and Push') {
            matrix {
                axes {
                    axis {
                        name 'PYTHON_VER'
                        values 3.8, 3.9
                    }
                }
                stages {
                    stage('Install and Test') {
                        agent {
                            docker {
                                image "python:${PYTHON_VER}"
                                args '-v $HOME/.cache/pip:/root/.cache/pip'
                                reuseNode true
                            }
                        }
                        steps {
                            // Install dependencies
                            sh '''
                                export HOME=${WORKSPACE}
                                pip install --upgrade pip
                                pip install faker
                            '''

                            // Test the application
                            dir(env.APP_PATH) {
                                sh '''
                                    export HOME=${WORKSPACE}
                                    set -e
                                    python app.py
                                '''
                            }
                        }
                    }

                    stage('Build and Push') {
                        // No agent override here; runs on the host agent (labeled 'docker')
                        steps {
                            dir(env.APP_PATH) {
                                script {
                                    def IMAGE_NAME = "${env.REPO_NAME}/faker:${PYTHON_VER}-slim-1.0"
                                    echo "Building Docker image ${IMAGE_NAME}..."
                                    docker.build(IMAGE_NAME)

                                    echo "Pushing Docker image ${IMAGE_NAME}..."
                                    docker.withRegistry('https://index.docker.io/v1/', env.DOCKERHUB_CREDENTIALS) {
                                        def appImage = docker.image(IMAGE_NAME)
                                        appImage.push()
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline completed."
            cleanWs()
        }
    }
}